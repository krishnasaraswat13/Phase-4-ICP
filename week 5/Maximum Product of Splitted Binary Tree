/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    long maxp=0;
    List<Long> ls=new ArrayList<>();
    public int maxProduct(TreeNode root) {
        ls.clear();
       long total=sum(root);
       for(long s:ls){
        long curr=s* (total-s);
        maxp=Math.max(maxp,curr);
       }
       return (int)(maxp % 1000000007);
    }
    long sum (TreeNode root){
        if(root==null) return 0;
        long curr=root.val+ sum(root.left) +sum(root.right);
        ls.add(curr);
        
        return curr;

    }
}