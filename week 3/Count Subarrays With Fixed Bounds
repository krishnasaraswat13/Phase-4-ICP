class Solution {
    public long countSubarrays(int[] nums, int minK, int maxK) {
        long minidx=-1;
        long maxidx=-1;
        long badidx=-1;
        long count=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]<minK || nums[i]>maxK){
                badidx=i;
            }
            if(nums[i]==minK){
                minidx=i;
            }
            if(nums[i]==maxK){
                maxidx=i;
            }
        
        long ans=Math.min(minidx,maxidx)-badidx;
        count+=Math.max(0L,ans);

        }
        return count;
    }
}