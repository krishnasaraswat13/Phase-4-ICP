class Solution {
    public int distributeCandies(int[] candyType) {
       HashMap<Integer,Integer> map=new HashMap<>();
       for(int i=0;i<candyType.length;i++){
            map.put(candyType[i],map.getOrDefault(candyType[i],0)+1);
       } 
       int t=map.size();
       int n=candyType.length;
       return (n/2>=t)?t:n/2;
    }
}