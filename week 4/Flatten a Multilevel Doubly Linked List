/*
// Definition for a Node.
class Node {
    public int val;
    public Node prev;
    public Node next;
    public Node child;
};
*/

class Solution {
    public Node flatten(Node head) {
        Node temp=head;
        if(temp==null){
            return head;
        }
        Stack<Node> st=new Stack<>();
        while(temp!=null){
            if(temp.child!=null){
                if(temp.next!=null){
                    st.push(temp.next);
            
                }
                temp.next=temp.child;
                temp.next.prev=temp;
                temp.child=null;
               
                }
                if(temp.next==null && !st.isEmpty()){
                    Node newN=st.pop();
                    temp.next=newN;
                    newN.prev=temp;
                }
                temp=temp.next;
               
            }
       
        return head;
    }
}